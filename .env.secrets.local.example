# Copie este arquivo para .env.secrets.local (na raiz do projeto) e preencha.
# .env.secrets.local está no .gitignore — nunca é commitado.
#
# A service_role key é encontrada no painel do Supabase em:
#   Project Settings > API > service_role secret
# Diferente da anon key (usada pelo app no navegador), a service_role key
# ignora Row Level Security e tem permissão de admin sobre o Storage —
# nunca a exponha no código do front-end nem em nenhum arquivo versionado.

SUPABASE_SERVICE_KEY=sua_service_role_key_aqui
